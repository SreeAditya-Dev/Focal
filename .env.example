# Focal Environment Configuration

# Backend API Configuration
DATABASE_URL=sqlite:///./focal.db
# For PostgreSQL in Docker / Cloud:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/focal_db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
